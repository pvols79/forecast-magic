PORT=3000
DATABASE_PATH=./data/app.db
# Standalone Docker defaults to localhost. Use 0.0.0.0 only for intentional LAN access.
FORECAST_MAGIC_BIND_ADDRESS=127.0.0.1
FORECAST_MAGIC_PORT=3000
# Shared-server example only; must match the existing NGINX Docker network.
PROXY_NETWORK=proxy
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=replace-with-a-long-random-value
REPORTING_API_TOKEN=replace-with-a-separate-long-random-value
LUNCH_MONEY_API_KEY=
# Optional for API mock testing only:
# LUNCH_MONEY_API_BASE_URL=https://api.lunchmoney.dev/v2
